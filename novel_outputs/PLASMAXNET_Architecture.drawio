        <mxCell id="fi_i4" value="Counterfactual shift vector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="90" y="610" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="fi_i5" value="Score vector&#xa;[ResNet prob, DenseNet prob, CF prob]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="90" y="720" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="fi_enc" value="Per-Stream Encoders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#81C784;strokeWidth=2;fontStyle=1;fontSize=21;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="440" y="220" width="470" height="760" as="geometry"/></mxCell>
        <mxCell id="fi_e1" value="Res encoder&#xa;LayerNorm(res_dim)&#xa;Linear(res_dim,h)&#xa;GELU + Dropout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="500" y="270" width="160" height="115" as="geometry"/></mxCell>
        <mxCell id="fi_e2" value="Dense encoder&#xa;LayerNorm(den_dim)&#xa;Linear(den_dim,h)&#xa;GELU + Dropout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="690" y="270" width="160" height="115" as="geometry"/></mxCell>
        <mxCell id="fi_e3" value="Morph encoder&#xa;LayerNorm(morph_dim)&#xa;Linear(morph_dim,t)&#xa;GELU + Dropout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="500" y="460" width="160" height="115" as="geometry"/></mxCell>
        <mxCell id="fi_e4" value="CF encoder&#xa;LayerNorm(cf_dim)&#xa;Linear(cf_dim,t)&#xa;GELU + Dropout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="690" y="460" width="160" height="115" as="geometry"/></mxCell>
        <mxCell id="fi_e5" value="Score encoder&#xa;LayerNorm(score_dim)&#xa;Linear(score_dim,t)&#xa;GELU + Dropout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="595" y="680" width="160" height="115" as="geometry"/></mxCell>
        <mxCell id="fi_cfmod" value="Counterfactual-Guided Modulation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#EC407A;strokeWidth=2;fontStyle=1;fontSize=21;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1010" y="220" width="520" height="760" as="geometry"/></mxCell>
        <mxCell id="fi_m1" value="cf_to_res&#xa;Linear(t,h) + Sigmoid&#xa;multiplies Res features" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EC407A;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1070" y="305" width="170" height="95" as="geometry"/></mxCell>
        <mxCell id="fi_m2" value="cf_to_den&#xa;Linear(t,h) + Sigmoid&#xa;multiplies Dense features" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EC407A;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1290" y="305" width="170" height="95" as="geometry"/></mxCell>
        <mxCell id="fi_m3" value="morph_to_scores&#xa;Linear(t+t,t) + GELU + Dropout&#xa;adds Morph + CF information into score stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EC407A;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1160" y="515" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="fi_m4" value="Modulated features&#xa;Res_feat * cf_to_res(cf_feat)&#xa;Den_feat * cf_to_den(cf_feat)&#xa;Score_feat + morph_to_scores([morph_feat, cf_feat])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EC407A;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1105" y="705" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="fi_fuse" value="Modality Gate and Fusion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FFB74D;strokeWidth=2;fontStyle=1;fontSize=21;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1630" y="220" width="580" height="760" as="geometry"/></mxCell>
        <mxCell id="fi_g1" value="gate_context = [res_feat, den_feat, morph_feat, cf_feat, score_feat]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1690" y="280" width="460" height="55" as="geometry"/></mxCell>
        <mxCell id="fi_g2" value="modality_gate&#xa;LayerNorm(h+h+t+t+t) -> Linear(...,4) -> Softmax" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1690" y="360" width="460" height="85" as="geometry"/></mxCell>
        <mxCell id="fi_g3" value="Gate outputs&#xa;g1 = ResNet weight&#xa;g2 = DenseNet weight&#xa;g3 = Morphology weight&#xa;g4 = Counterfactual weight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1690" y="470" width="460" height="100" as="geometry"/></mxCell>
        <mxCell id="fi_g4" value="Unify layers&#xa;res_unify(h,h) | den_unify(h,h)&#xa;morph_unify(t,h) | cf_unify(t,h) | score_unify(t,h)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FDD835;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1690" y="600" width="460" height="75" as="geometry"/></mxCell>
        <mxCell id="fi_g5" value="Weighted fusion&#xa;fused_modal = g1*res_unify(res) + g2*den_unify(den) + g3*morph_unify(morph) + g4*cf_unify(cf)&#xa;fused = concat(fused_modal, score_unify(score))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FDD835;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1690" y="705" width="460" height="105" as="geometry"/></mxCell>
        <mxCell id="fi_g6" value="Classifier head&#xa;LayerNorm(2h) -> Linear(2h,h) -> GELU -> Dropout -> Linear(h,2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FB8C00;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1690" y="835" width="460" height="75" as="geometry"/></mxCell>
        <mxCell id="fe1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#546E7A;" edge="1" parent="1" source="fi_input" target="fi_enc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AD1457;" edge="1" parent="1" source="fi_enc" target="fi_cfmod"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#F57F17;" edge="1" parent="1" source="fi_cfmod" target="fi_fuse"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
