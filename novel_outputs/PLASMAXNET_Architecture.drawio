        <mxCell id="tx_t5" value="Saved training artifacts&#xa;best_fusion_history.csv&#xa;fusion_search_histories.json&#xa;ablation_results.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E24AA;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="240" y="465" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="tx_t6" value="Ablation study&#xa;Image only&#xa;Without morphology&#xa;Without counterfactual path&#xa;Full novel fusion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E24AA;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="240" y="595" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="tx_eval" value="B. Evaluation and Statistical Support" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FFB74D;strokeWidth=2;fontStyle=1;fontSize=21;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="850" y="150" width="720" height="620" as="geometry"/></mxCell>
        <mxCell id="tx_e1" value="Primary metrics&#xa;accuracy, weighted F1, plasma precision, plasma recall, AUC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FB8C00;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="900" y="210" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="tx_e2" value="Plot outputs&#xa;training curves&#xa;ROC + confusion matrix&#xa;calibration curve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FB8C00;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1210" y="210" width="300" height="90" as="geometry"/></mxCell>
