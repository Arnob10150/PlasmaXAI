        <mxCell id="tx_t2" value="Optimization&#xa;AdamW optimizer&#xa;CosineAnnealingLR scheduler&#xa;CrossEntropyLoss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E24AA;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="390" y="210" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="tx_t3" value="Stopping logic&#xa;Track validation performance&#xa;early stopping by patience" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E24AA;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="95" y="335" width="250" height="80" as="geometry"/></mxCell>
