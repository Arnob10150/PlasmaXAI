        <mxCell id="tx_e4" value="Model comparison&#xa;Novel fusion vs previous hybrid vs ResNet vs DenseNet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FB8C00;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1210" y="340" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="tx_e5" value="Saved summary files&#xa;novel_summary.json&#xa;bootstrap_summary.json&#xa;clinical_insight_report.txt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FB8C00;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1045" y="480" width="320" height="95" as="geometry"/></mxCell>
