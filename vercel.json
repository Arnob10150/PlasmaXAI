{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "web": {
      "entrypoint": "apps/web",
      "routePrefix": "/",
      "framework": "nextjs"
    },
    "inference": {
      "entrypoint": "apps/inference/app/app.py",
      "routePrefix": "/api/inference",
      "memory": 3009,
      "maxDuration": 60,
      "includeFiles": [
        "apps/inference/model_assets/**"
      ]
    }
  }
}
